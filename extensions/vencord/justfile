setup:
	if [ ! -d "Vencord" ]; then \
		echo "Cloning Vencord..."; \
		git clone https://github.com/Vendicated/Vencord; \
	fi
	cd Vencord && pnpm install
	just link-plugin
	pnpm install

[private]
link-plugin:
	mkdir -p Vencord/src/userplugins/
	if [ -e "Vencord/src/userplugins/PlickoVencord" ] && [ ! -L "Vencord/src/userplugins/PlickoVencord" ]; then \
		echo "Cannot link PlickoVencord: path exists and is not a symlink" >&2; \
		exit 1; \
	fi
	# Keep the link valid when the checkout is moved.
	ln -sfn ../../../src Vencord/src/userplugins/PlickoVencord

inject:
    cd Vencord && pnpm inject

build: link-plugin
	cd Vencord && pnpm build

dev: link-plugin
    cd Vencord && pnpm build --watch
